APP_ENV=production
SECRET_KEY=replace-with-output-of-python-secrets-command
PUBLIC_BASE_URL=https://avalon-public.example-tailnet.ts.net
PUBLIC_ORIGIN=https://avalon-public.example-tailnet.ts.net
TRUST_PROXY_HEADERS=true
ENABLE_DEV_ROUTES=false
MAX_CONNECTIONS=100
MAX_CONNECTIONS_PER_IP=30
MAX_GAMES=50
MAX_RATE_KEYS=5000
GAME_TTL_SECONDS=43200
CHAT_DB_PATH=/data/avalon-chats.sqlite3
CHAT_DB_MAX_BYTES=943718400
